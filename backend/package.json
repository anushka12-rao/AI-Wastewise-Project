{
  "name": "ai-wastewise-backend",
  "version": "1.0.0",
  "description": "Backend service for AI WasteWise - Intelligent Waste Identification and Responsible Disposal Assistant",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:kb": "node src/scripts/seedKnowledgeBase.js",
    "seed": "node src/scripts/seedAdmin.js && node src/scripts/seedKnowledgeBase.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "test:unit": "cross-env NODE_ENV=test jest tests/unit --runInBand",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration --runInBand",
    "test:security": "cross-env NODE_ENV=test jest tests/security --runInBand"
  },
  "keywords": [
    "waste-management",
    "sdg12",
    "ibm-watsonx",
    "granite",
    "rag",
    "lancedb"
  ],
  "author": "AI WasteWise Team",
  "license": "ISC",
  "dependencies": {
    "@lancedb/lancedb": "^0.13.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "mongodb-memory-server": "^10.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true
  }
}
