# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas M0 or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai_wastewise

# Authentication & Session Security
SESSION_SECRET=wastewise_super_secure_session_secret_key_2026_xyz
ADMIN_EMAIL=admin@wastewise.org
ADMIN_PASSWORD=AdminWasteWise#2026

# IBM watsonx.ai Credentials
# If left blank or WATSONX_SIMULATION_MODE=true, the intelligent watsonx simulator is used
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_SIMULATION_MODE=true

# Gate Thresholds (Configurable)
IDENTIFICATION_CONFIDENCE_THRESHOLD=0.70
RETRIEVAL_SCORE_THRESHOLD=0.65

# LanceDB Vector Store Path
LANCEDB_PATH=./data/lancedb
